{
  "name": "@codex-prism/root",
  "description": "Open-Source AI LaTeX writing workspace",
  "version": "1.6.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/beniz/codex-prism"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:desktop:watch": "node scripts/dev-desktop.mjs --watch",
    "build:desktop": "node scripts/build-desktop.mjs",
    "lint": "pnpm exec biome check",
    "lint:fix": "pnpm exec biome check --fix",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:build": "node scripts/release.mjs build",
    "test:release": "node --test scripts/release.test.mjs scripts/github-release.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "rollup": ">=4.58.0",
      "serialize-javascript": ">=6.0.3",
      "undici": ">=7.24.0",
      "flatted": ">=3.4.0",
      "hono": ">=4.12.7",
      "ws": ">=8.20.1",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1"
    }
  }
}
